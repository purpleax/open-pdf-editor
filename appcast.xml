    <item>
      <title>Open PDF Editor 0.7.1</title>
      <pubDate>Mon, 19 Oct 2026 13:07:22 +0000</pubDate>
      <link>https://github.com/purpleax/open-pdf-editor/releases/tag/v0.7.1</link>
      <sparkle:version>9</sparkle:version>
      <sparkle:shortVersionString>0.7.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
      <sparkle:fullReleaseNotesLink>https://github.com/purpleax/open-pdf-editor/releases/tag/v0.7.1</sparkle:fullReleaseNotesLink>
      <description sparkle:format="markdown">Select and type. Select some text and start typing, and it changes, just as in a word processor: no need to switch to editing first. Click anywhere in a paragraph and a cursor appears there for typing; Delete, Backspace and Return work the same way, and Space types a space when there's a cursor or selection (it still scrolls otherwise). Paragraphs whose lines happen to end together are no longer mistaken for justified text, so their spacing stays as it was after an edit.</description>
